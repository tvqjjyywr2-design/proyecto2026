    "test:productos": "node --test scripts/api-productos.test.js",
    "test:proceso-compra": "node --test scripts/api-proceso-compra.test.js",
    "test:detalle-compra": "node --test scripts/api-detalle-compra.test.js",
    "test:administrador": "node --test scripts/api-administrador.test.js"
  },
