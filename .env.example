# Servidor
PORT=3000
NODE_ENV=development

# Base de datos MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_golf
DB_CONNECTION_LIMIT=10

# Hash de contraseñas (bcrypt)
BCRYPT_ROUNDS=10

# CORS: "*" para permitir cualquier origen o una lista separada por comas
CORS_ORIGIN=*
